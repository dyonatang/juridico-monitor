{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "agendador",
      "codebase": "agendador",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "hosting": {
    "site": "dfv-juridico",
    "public": "hosting-publico",
    "ignore": [
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "portal",
          "region": "us-central1"
        }
      }
    ]
  }
}
