# URL do Jurídico Monitor (sem barra no final)
SISTEMA_URL=https://SEU-DOMINIO
# Mesmo valor de INGEST_TOKEN configurado no sistema
INGEST_TOKEN=cole-o-token-aqui

# Pasta onde fica o perfil do navegador (sessão gov.br). Não apague nem versione.
PERFIL_DIR=./perfil
# true = navegador invisível (servidor). Use false para ver o que acontece.
HEADLESS=true
# Também baixar o arquivo original (PDF/HTML) além do texto? (maior tráfego/armazenamento)
BAIXAR_BINARIO=false
# Máximo de peças novas por rodada (protege a cota de IA no primeiro dia)
MAX_PECAS_POR_RODADA=60
