# ---- Firebase (Firestore) — obrigatório para rodar local ----------------
# Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada.
# Salve o JSON baixado como `firebase-key.json` nesta pasta (já está no .gitignore) e aponte:
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-key.json
# (Alternativa: FIREBASE_SERVICE_ACCOUNT com o JSON inteiro em uma linha.)
# (No Firebase App Hosting nada disso é necessário — as credenciais são automáticas.)

# ---- URL pública do app (usada nos callbacks dos provedores) ------------
APP_URL=http://localhost:3000
APP_GRUPO=Grupo Giovanelli · Assis

# ---- Storage (PDFs importados) — opcional; padrão <projeto>.firebasestorage.app
# FIREBASE_STORAGE_BUCKET=juridico-monitor.firebasestorage.app

# ---- Leitura de PDF por IA (Anthropic) — opcional, mas recomendado ------
# console.anthropic.com > API keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# ---- Segurança ----------------------------------------------------------
DASHBOARD_USER=dyonatan
DASHBOARD_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-um-token-longo-aleatorio   # assina o cookie de login
MCP_TOKEN=gere-um-token-longo-aleatorio      # Bearer usado pelo Claude para falar com /api/mcp
CRON_SECRET=gere-outro-token                 # Cloud Scheduler chama /api/cron/sync?secret=...
WEBHOOK_SECRET=gere-outro-token              # ?secret= nos callbacks da Judit/Escavador

# ---- Fonte gratuita (CNJ) — opcional, usa a chave pública por padrão ----
# DATAJUD_API_KEY=

# ---- Provedor premium (busca/monitoramento por CPF/CNPJ) — opcional ------
# MONITOR_PROVIDER=judit          # judit | escavador
# JUDIT_API_KEY=
# JUDIT_RECURRENCE_DAYS=1
# ESCAVADOR_TOKEN=

# ---- Notificações — opcional ---------------------------------------------
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL_FROM="Juridico Monitor <juridico@seudominio.com.br>"
# NOTIFY_EMAIL_TO=dyonatan@caranguejodoassis.com.br
# NOTIFY_WEBHOOK_URL=https://...   # ex.: Evolution API / Z-API / n8n → WhatsApp
# NOTIFY_WEBHOOK_TOKEN=
